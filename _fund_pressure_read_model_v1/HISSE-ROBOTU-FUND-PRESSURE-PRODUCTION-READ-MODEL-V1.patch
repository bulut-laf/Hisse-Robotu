+            "Likidasyon Normal (gün)": None if raw is None else _decimal_display(raw.liquidity.liquidation_days_normal),
+            "Likidasyon Agresif (gün)": None if raw is None else _decimal_display(raw.liquidity.liquidation_days_aggressive),
+            "Likidasyon Stres (gün)": None if raw is None else _decimal_display(raw.liquidity.liquidation_days_stress),
+            "Fon Yoğunluğu": _decimal_display(profile.fund_concentration_risk.score),
