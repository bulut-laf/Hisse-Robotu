def test_batch_limit_blocks_accidental_full_universe_traversal(
    tmp_path,
):
    store = FundObservationJsonStore(
        tmp_path / "observations.json"
    )

    with pytest.raises(
        ValueError,
        match="F3_BATCH_LIMIT_EXCEEDED",
    ):
        population.populate_tefas_history_batch(
            ("AAA", "BBB", "CCC"),
            store=store,
            maximum_funds=2,
            fetched_at=STAMP,
            source_as_of=STAMP,
        )


def test_fetch_failure_occurs_before_any_store_write(
    tmp_path,
    monkeypatch,
):
    def fake_fetch(
        fund_code,
        *,
        period=1,
        timeout_seconds=10,
    ):
        if fund_code == "BBB":
            raise RuntimeError("NETWORK_TEST_FAILURE")

        return (
            row(fund_code, "2026-08-03", "100"),
            row(fund_code, "2026-08-04", "101"),
            row(fund_code, "2026-08-05", "102"),
        )

    monkeypatch.setattr(
        population,
        "fetch_tefas_fund_history_rows",
        fake_fetch,
    )

    path = tmp_path / "observations.json"

    store = FundObservationJsonStore(path)

    with pytest.raises(
        RuntimeError,
        match="NETWORK_TEST_FAILURE",
    ):
        population.populate_tefas_history_batch(
            ("AAA", "BBB"),
            store=store,
            fetched_at=STAMP,
            source_as_of=STAMP,
        )

    # No half-written persistent batch.
    assert not path.exists()


def test_timezone_is_required(
    tmp_path,
):
    store = FundObservationJsonStore(
        tmp_path / "observations.json"
    )

    with pytest.raises(
        ValueError,
        match="TIMEZONE_AWARE",
    ):
        population.populate_tefas_history_batch(
            ("AAA",),
            store=store,
            fetched_at=datetime(2026, 9, 2, 12, 0),
            source_as_of=STAMP,
        )
