def test_directory_discovers_only_requested_symbols_and_converts_summary_to_general():
    refs = parse_kap_bist_company_directory(
        _directory_html(),
        symbols=("AEFES", "SAHOL"),
    )
    assert set(refs) == {"AEFES", "SAHOL"}
    assert refs["SAHOL"].general_url == (
        "https://www.kap.org.tr/tr/sirket-bilgileri/genel/"
        "976-haci-omer-sabanci-holding-a-s"
    )


def test_general_page_parses_official_free_float_amount_in_nominal_tl_unit():
    record = parse_kap_free_float_general_page(
        _general_html(),
        source_url=(
            "https://www.kap.org.tr/tr/sirket-bilgileri/genel/"
            "858-anadolu-efes-biracilik-ve-malt-sanayii-a-s"
        ),
        expected_symbol="AEFES",
        observed_on=date(2026, 9, 4),
    )
    assert record.symbol == "AEFES"
    assert record.free_float_shares == Decimal("1911232452.75")
    assert record.as_of == date(2026, 9, 4)
    assert record.source == "KAP"


def test_general_page_requires_expected_symbol_row():
