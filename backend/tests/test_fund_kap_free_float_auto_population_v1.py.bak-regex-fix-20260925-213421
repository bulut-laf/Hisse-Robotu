def test_population_fetches_one_official_table_and_persists_requested_records(tmp_path):
    store = FreeFloatJsonStore(tmp_path / "fdo.json")
    calls = []

    def table_fetcher(url, timeout):
        calls.append((url, timeout))
        assert url == KAP_FREE_FLOAT_TABLE_URL
        return _free_float_table_html().encode(), url, "text/html; charset=utf-8"

    summary = populate_kap_free_float_for_symbols(
        store=store,
        symbols=("SAHOL", "TTKOM"),
        network_enabled=True,
        observed_on=date(2026, 9, 4),
        table_fetcher=table_fetcher,
    )

    assert len(calls) == 1
    assert summary.requested == 2
    assert summary.discovered == 2
    assert summary.attempted == 2
    assert summary.inserted == 2
    assert summary.failures == ()
    assert {item.symbol for item in store.list_records()} == {"SAHOL", "TTKOM"}


def test_population_is_idempotent_for_same_observation_and_source(tmp_path):
    store = FreeFloatJsonStore(tmp_path / "fdo.json")

    def table_fetcher(url, timeout):
        return _free_float_table_html().encode(), url, "text/html"

    first = populate_kap_free_float_for_symbols(
        store=store,
        symbols=("SAHOL",),
        network_enabled=True,
        observed_on=date(2026, 9, 4),
        table_fetcher=table_fetcher,
    )
    second = populate_kap_free_float_for_symbols(
        store=store,
        symbols=("SAHOL",),
        network_enabled=True,
        observed_on=date(2026, 9, 4),
        table_fetcher=table_fetcher,
    )
    assert first.inserted == 1
    assert second.inserted == 0
    assert second.unchanged == 1


def test_population_isolates_missing_symbol_and_keeps_valid_record(tmp_path):
    store = FreeFloatJsonStore(tmp_path / "fdo.json")

    def table_fetcher(url, timeout):
        return _free_float_table_html(include_ttkom=False).encode(), url, "text/html"

    summary = populate_kap_free_float_for_symbols(
        store=store,
        symbols=("SAHOL", "TTKOM"),
        network_enabled=True,
        observed_on=date(2026, 9, 4),
        table_fetcher=table_fetcher,
    )
    assert summary.inserted == 1
    assert len(summary.failures) == 1
    assert summary.failures[0].symbol == "TTKOM"
    assert summary.failures[0].error == "KAP_FDO_SYMBOL_ROW_MISSING:TTKOM"


def test_population_rejects_non_kap_redirect_without_mutating_store(tmp_path):
    store = FreeFloatJsonStore(tmp_path / "fdo.json")

    def table_fetcher(url, timeout):
        return _free_float_table_html().encode(), "https://evil.example/fdo", "text/html"

    with pytest.raises(KapFreeFloatError, match="HOST_NOT_ALLOWED"):
        populate_kap_free_float_for_symbols(
            store=store,
            symbols=("SAHOL",),
            network_enabled=True,
            observed_on=date(2026, 9, 4),
            table_fetcher=table_fetcher,
        )
    assert store.list_records() == ()



