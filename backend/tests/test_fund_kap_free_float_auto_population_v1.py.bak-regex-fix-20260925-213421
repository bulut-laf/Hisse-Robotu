            expected_symbol="AEFES",
            observed_on=date(2026, 9, 4),
        )


def test_discovery_never_calls_network_without_explicit_enablement():
    calls = []

    def forbidden(url, timeout):
        calls.append((url, timeout))
        raise AssertionError("NETWORK_CALLED")

    with pytest.raises(KapFreeFloatError, match="NETWORK_DISABLED"):
        discover_kap_company_general_urls(
            symbols=("AEFES",),
            fetcher=forbidden,
        )
    assert calls == []


def test_official_aggregate_table_parses_sahol_and_ttkom_rows():
    records = parse_kap_free_float_table(
        _free_float_table_html(),
        symbols=("SAHOL", "TTKOM"),
        source_url=KAP_FREE_FLOAT_TABLE_URL,
        observed_on=date(2026, 9, 4),
    )
    by_symbol = {item.symbol: item for item in records}
    assert by_symbol["SAHOL"].free_float_shares == Decimal("1094758337.4")
    assert by_symbol["TTKOM"].free_float_shares == Decimal("463448324.45")
    assert by_symbol["SAHOL"].source_ref == KAP_FREE_FLOAT_TABLE_URL


