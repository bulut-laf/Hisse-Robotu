+def test_population_fetches_directory_then_general_pages_and_persists_canonical_records(tmp_path):
+    store = FreeFloatJsonStore(tmp_path / "fdo.json")
+
+    def directory_fetcher(url, timeout):
+        assert url == KAP_BIST_COMPANIES_URL
+        return _directory_html().encode(), url, "text/html; charset=utf-8"
+
+    def general_fetcher(url, timeout):
+        symbol = "AEFES" if "858-" in url else "SAHOL"
+        amount = "1.911.232.452,75" if symbol == "AEFES" else "1.250.000.000,00"
+        return _general_html(symbol, amount, "40,00").encode(), url, "text/html"
+
+    summary = populate_kap_free_float_for_symbols(
+        store=store,
+        symbols=("AEFES", "SAHOL"),
+        network_enabled=True,
+        observed_on=date(2026, 9, 4),
+        directory_fetcher=directory_fetcher,
+        general_fetcher=general_fetcher,
+    )
+
+    assert summary.requested == 2
+    assert summary.discovered == 2
+    assert summary.attempted == 2
+    assert summary.inserted == 2
+    assert summary.failures == ()
+    assert {item.symbol for item in store.list_records()} == {"AEFES", "SAHOL"}
+
