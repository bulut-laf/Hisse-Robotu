diff --git a/backend/tests/test_fund_kap_free_float_auto_population_v1.py b/backend/tests/test_fund_kap_free_float_auto_population_v1.py
new file mode 100644
index 0000000..0b0cb25
--- /dev/null
+++ b/backend/tests/test_fund_kap_free_float_auto_population_v1.py
@@ -0,0 +1,194 @@
+from datetime import date
+from decimal import Decimal
+
+import pytest
+
+from backend.app.funds.free_float_store import FreeFloatJsonStore
+from backend.app.funds.kap_free_float_auto_population import (
+    KAP_BIST_COMPANIES_URL,
+    KapFreeFloatError,
+    discover_kap_company_general_urls,
+    parse_kap_bist_company_directory,
+    parse_kap_free_float_general_page,
+    populate_kap_free_float_for_symbols,
+)
+
+
+def _directory_html():
+    return """
+    <html><body>
+      <a href="/tr/sirket-bilgileri/ozet/858-anadolu-efes-biracilik-ve-malt-sanayii-a-s">AEFES</a>
+      <a href="/tr/sirket-bilgileri/ozet/999-sabanci-holding-a-s">SAHOL</a>
+      <a href="https://evil.example/tr/sirket-bilgileri/ozet/1-x">TTKOM</a>
+    </body></html>
+    """
+
+
+def _general_html(symbol="AEFES", amount="1.911.232.452,75", ratio="32,28"):
+    return f"""
+    <html><body>
+      <h2>Fiili Dolaşımdaki Paylar</h2>
+      <table>
+        <tr><th>Borsa Kodu</th><th>Fiili Dolaşımdaki Pay Tutarı(TL)</th><th>Fiili Dolaşımdaki Pay Oranı(%)</th></tr>
+        <tr><td>{symbol}</td><td>{amount}</td><td>{ratio}</td></tr>
+      </table>
+      <h2>Sermayeyi Temsil Eden Paylara İlişkin Bilgi</h2>
+    </body></html>
+    """
+
+
+def test_directory_discovers_only_requested_symbols_and_converts_summary_to_general():
+    refs = parse_kap_bist_company_directory(
+        _directory_html(),
+        symbols=("AEFES", "SAHOL"),
+    )
+    assert set(refs) == {"AEFES", "SAHOL"}
+    assert refs["AEFES"].general_url == (
+        "https://www.kap.org.tr/tr/sirket-bilgileri/genel/"
+        "858-anadolu-efes-biracilik-ve-malt-sanayii-a-s"
+    )
