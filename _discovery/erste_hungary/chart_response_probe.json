      if (modal.querySelector('#package-559-extra')) return;
      const headerColumn = packageLink.closest('.col-12');
      if (!headerColumn) return;
      headerColumn.insertAdjacentHTML('afterend', `<div class="col-12 m-0 mb-2" id="package-559-extra"><div style="background-color: #401A48;" class="card custom-card bg-erste-future-purple text-left text-white p-4 rounded"><div class="card-body p-0"><h2 class="card-title text-left font-size-22-important line-height-32 mb-2">${futureHackTitle}</h2><div class="card-text mb-0 pb-0">${futureHackText}</div></div></div></div>`);
    }
    const observer = new MutationObserver(insertExtraContent);
    observer.observe(modal, {
      childList: true,
      subtree: true
    });
    insertExtraContent();
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
})();
